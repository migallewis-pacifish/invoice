<!doctype html><html><head><meta charset="utf-8"><title>${letter.title?html}</title><style>
@page{size:A4;margin:0}*{box-sizing:border-box}body{margin:0;background:#eeeae1;color:#273b35;font:12pt Georgia,serif}.page{width:210mm;min-height:297mm;margin:auto;background:#fcfaf4;padding:18mm 19mm;position:relative}.head{display:flex;justify-content:space-between;align-items:start;border-bottom:1px solid #9caf9f;padding-bottom:11mm}.brand-wrap{display:flex;align-items:center}.mark{width:16mm;height:16mm;border:1px solid #647e70;border-radius:50%;display:grid;place-items:center;font:700 20px Arial;color:#647e70}.brand{margin-left:5mm;font-size:20px}.date{text-align:right;font:10px Arial;line-height:1.7;color:#8b664a}.recipient{margin:14mm 0 12mm;padding-left:8mm;border-left:1px solid #9caf9f;line-height:1.55}.label{font:700 9px Arial;text-transform:uppercase;letter-spacing:.16em;color:#8b664a}.recipient strong{display:block;font-size:17px;margin:5px 0}.subject{font-size:25px;font-weight:normal;color:#526d60;margin:0 0 8mm}.message{white-space:pre-line;line-height:1.72}.closing{margin-top:15mm;font-style:italic}.signature{height:18mm;display:flex;align-items:end}.signature img{max-width:45mm;max-height:16mm}.signed{font-style:normal;font-weight:bold}.foot{position:absolute;bottom:16mm;left:19mm;right:19mm;border-top:1px solid #9caf9f;padding-top:6mm;display:flex;justify-content:space-between;font:10px Arial;color:#53625d}.foot b{color:#8b664a}
</style></head><body><main class="page"><header class="head"><div class="brand-wrap"><div class="mark">${company.name?substring(0,1)?upper_case?html}</div><div class="brand">${company.name?html}</div></div><div class="date"><span class="label">Written</span><br>${letter.date?html}</div></header><section class="recipient"><div class="label">For</div><strong>${client.name?html}</strong><#if client.address.line1?has_content>${client.address.line1?html}<br></#if><#if client.address.suburb?has_content>${client.address.suburb?html}<br></#if><#if client.address.city?has_content>${client.address.city?html}<#if client.address.postalCode?has_content> ${client.address.postalCode?html}</#if></#if></section><h1 class="subject">${letter.title?html}</h1><article class="message">${letter.message}</article><section class="closing">With warm regards,<div class="signature"><#if letter.signatureUrl?has_content><img src="${letter.signatureUrl?html}" alt="Signature"></#if></div><#if letter.signedBy?has_content><div class="signed">${letter.signedBy?html}</div></#if></section><footer class="foot"><div><b>CONTACT</b><br><#if company.email?has_content>${company.email?html}</#if></div><div><#if company.website?has_content>${company.website?html}<br></#if><#if company.phone?has_content>${company.phone?html}</#if></div></footer></main></body></html>
