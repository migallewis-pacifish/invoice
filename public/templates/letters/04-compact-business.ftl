<!doctype html>
<html><head><meta charset="utf-8"><title>${letter.title?html}</title><style>
@page{size:A4;margin:0}:root{--primary:${(theme.sidebarColor1!'#1f2933')};--accent:${(theme.sidebarColor2!'#69727d')};--soft:${(theme.sidebarColor3!'#edf0f2')}}*{box-sizing:border-box}body{margin:0;background:#e5e7eb;color:#20252b;font:10.5pt Arial,sans-serif}.page{width:210mm;min-height:297mm;margin:auto;background:#fff;padding:17mm 19mm 18mm;position:relative}.head{display:grid;grid-template-columns:1fr 1fr;gap:12mm;align-items:start}.brand{font-size:20pt;font-weight:800;color:var(--primary)}.sender{text-align:right;font-size:8.5pt;line-height:1.5;color:#5c6570}.bar{height:5mm;background:var(--primary);margin:8mm 0}.meta{display:grid;grid-template-columns:24mm 1fr 24mm 1fr;border:1px solid var(--soft);font-size:9pt;margin-bottom:10mm}.meta>*{padding:3mm;border-right:1px solid var(--soft)}.meta>*:last-child{border:0}.key{background:var(--soft);font-weight:700;text-transform:uppercase;font-size:7.5pt;letter-spacing:.08em;color:var(--accent)}.recipient{display:grid;grid-template-columns:24mm 1fr;margin-bottom:11mm;line-height:1.5}.recipient .key{padding:1mm 0;background:none}.recipient strong{font-size:12pt}.title{font-size:18pt;margin:0 0 7mm;padding-bottom:4mm;border-bottom:2px solid var(--primary);color:var(--primary)}.message{white-space:pre-line;line-height:1.65}.closing{margin-top:13mm;display:grid;grid-template-columns:1fr 52mm;align-items:end}.signature{height:17mm}.signature img{max-width:43mm;max-height:15mm}.signed{font-weight:bold}.company-seal{border-left:1px solid var(--soft);padding-left:6mm;font-size:8.5pt;color:var(--accent)}.foot{position:absolute;bottom:11mm;left:19mm;right:19mm;background:var(--soft);padding:3mm 4mm;display:flex;justify-content:space-between;font-size:8pt;color:#59616b}
</style></head><body><main class="page"><header class="head"><div><#if company.logoUrl?has_content><img src="${company.logoUrl?html}" alt="" style="max-width:48mm;max-height:15mm"><#else><div class="brand">${company.name?html}</div></#if></div><div class="sender"><#if company.address?has_content>${company.address?html}<br></#if><#if company.phone?has_content>${company.phone?html} · </#if>${company.email?html}</div></header><div class="bar"></div><section class="meta"><div class="key">Date</div><div>${letter.date?html}</div><div class="key">Reference</div><div>${letter.title?html}</div></section><section class="recipient"><div class="key">To</div><div><strong>${client.name?html}</strong><br><#if client.street?has_content>${client.street?html}<br></#if><#if client.suburb?has_content>${client.suburb?html}, </#if>${client.city?html}<#if client.postalCode?has_content> ${client.postalCode?html}</#if><#if client.email?has_content><br>${client.email?html}</#if></div></section><h1 class="title">${letter.title?html}</h1><article class="message">${letter.message}</article><section class="closing"><div><div>Sincerely,</div><div class="signature"><#if letter.signatureUrl?has_content><img src="${letter.signatureUrl?html}" alt="Signature"></#if></div><#if letter.signedBy?has_content><div class="signed">${letter.signedBy?html}</div></#if></div><div class="company-seal">Authorised for<br><strong>${company.name?html}</strong></div></section><footer class="foot"><span><#if company.registrationNumber?has_content>Reg. ${company.registrationNumber?html}</#if></span><span><#if company.website?has_content>${company.website?html}</#if></span></footer></main></body></html>

