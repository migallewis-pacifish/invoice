<!doctype html>
<html><head><meta charset="utf-8"><title>${letter.title?html}</title><style>
@page{size:A4;margin:0}:root{--primary:${(theme.sidebarColor1!'#282828')};--accent:${(theme.sidebarColor2!'#777')};--soft:${(theme.sidebarColor3!'#eeeeec')}}*{box-sizing:border-box}body{margin:0;background:#e5e7eb;color:#292929;font:12pt Georgia,serif}.page{width:210mm;min-height:297mm;margin:auto;background:#fff;padding:17mm 25mm 20mm;position:relative}.mast{text-align:center;padding-bottom:12mm}.brand{font:700 18pt Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--primary)}.contact{margin-top:3mm;font:8.5pt Arial,sans-serif;color:var(--accent);letter-spacing:.04em}.ornament{display:flex;align-items:center;gap:5mm;margin-top:9mm}.ornament:before,.ornament:after{content:'';height:1px;background:var(--soft);flex:1}.ornament span{width:4mm;height:4mm;transform:rotate(45deg);background:var(--accent)}.meta{text-align:center;font:9pt Arial,sans-serif;color:var(--accent);margin-bottom:11mm}.to{font-style:italic}.title{text-align:center;max-width:130mm;margin:0 auto 12mm;font-size:26pt;font-weight:normal;line-height:1.18;color:var(--primary)}.message{max-width:132mm;margin:auto;white-space:pre-line;line-height:1.75}.signoff{text-align:center;margin:17mm auto 0}.signature{height:17mm}.signature img{max-width:42mm;max-height:15mm}.signed{font:700 10pt Arial,sans-serif;letter-spacing:.05em}.footer{position:absolute;bottom:13mm;left:25mm;right:25mm;text-align:center;padding-top:4mm;border-top:1px solid var(--soft);font:8pt Arial,sans-serif;color:var(--accent)}
</style></head><body><main class="page"><header class="mast"><#if company.logoUrl?has_content><img src="${company.logoUrl?html}" alt="" style="max-width:55mm;max-height:16mm"><#else><div class="brand">${company.name?html}</div></#if><div class="contact"><#if company.email?has_content>${company.email?html}</#if><#if company.phone?has_content> · ${company.phone?html}</#if><#if company.website?has_content> · ${company.website?html}</#if></div><div class="ornament"><span></span></div></header><div class="meta">${letter.date?html}<br><span class="to">Prepared for ${client.name?html}</span></div><h1 class="title">${letter.title?html}</h1><article class="message">${letter.message}</article><section class="signoff"><div>With regards,</div><div class="signature"><#if letter.signatureUrl?has_content><img src="${letter.signatureUrl?html}" alt="Signature"></#if></div><#if letter.signedBy?has_content><div class="signed">${letter.signedBy?html}</div></#if></section><footer class="footer"><#if company.address?has_content>${company.address?html}</#if><#if company.registrationNumber?has_content> · Registration ${company.registrationNumber?html}</#if></footer></main></body></html>

