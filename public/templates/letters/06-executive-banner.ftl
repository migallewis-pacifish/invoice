<!doctype html>
<html><head><meta charset="utf-8"><title>${letter.title?html}</title><style>
@page{size:A4;margin:0}:root{--primary:${(theme.sidebarColor1!'#252930')};--accent:${(theme.sidebarColor2!'#737a84')};--soft:${(theme.sidebarColor3!'#eef0f2')}}*{box-sizing:border-box}body{margin:0;background:#e5e7eb;color:#222831;font:11pt Arial,sans-serif}.page{width:210mm;min-height:297mm;margin:auto;background:#fff;position:relative}.banner{height:47mm;background:var(--primary);color:#fff;padding:13mm 21mm;display:flex;justify-content:space-between;align-items:center}.brand{font-size:21pt;font-weight:700;max-width:100mm}.banner-mark{font-size:8pt;letter-spacing:.18em;text-transform:uppercase;border:1px solid currentColor;padding:3mm 4mm}.content{padding:13mm 21mm 24mm}.intro{display:grid;grid-template-columns:1fr 54mm;gap:15mm;padding-bottom:9mm;border-bottom:1px solid var(--soft);margin-bottom:11mm}.to{line-height:1.5}.to .label,.date .label{display:block;font-size:7.5pt;text-transform:uppercase;letter-spacing:.14em;color:var(--accent);margin-bottom:2mm}.to strong{font-size:14pt}.date{text-align:right}.date b{font-size:11pt}.title{font-size:25pt;line-height:1.12;margin:0 0 10mm;color:var(--primary);max-width:145mm}.message{white-space:pre-line;line-height:1.7;max-width:155mm}.closing{margin-top:16mm;display:flex;justify-content:space-between;align-items:end}.signature{height:17mm}.signature img{max-width:45mm;max-height:15mm}.signed{font-weight:700}.sender-card{width:58mm;padding:4mm;background:var(--soft);font-size:8.5pt;line-height:1.5;color:var(--accent)}.sender-card strong{color:var(--primary)}.footer{position:absolute;bottom:0;left:0;right:0;min-height:15mm;padding:5mm 21mm;background:var(--soft);display:flex;justify-content:space-between;font-size:8pt;color:var(--accent)}
</style></head><body><main class="page"><header class="banner"><div><#if company.logoUrl?has_content><img src="${company.logoUrl?html}" alt="" style="max-width:54mm;max-height:19mm"><#else><div class="brand">${company.name?html}</div></#if></div><div class="banner-mark">Official letter</div></header><section class="content"><div class="intro"><div class="to"><span class="label">Addressed to</span><strong>${client.name?html}</strong><#if client.address?has_content><br>${client.address?html}<#else><#if client.street?has_content><br>${client.street?html}</#if><#if client.city?has_content><br>${client.city?html}</#if><#if client.postalCode?has_content> ${client.postalCode?html}</#if></#if></div><div class="date"><span class="label">Date</span><b>${letter.date?html}</b></div></div><h1 class="title">${letter.title?html}</h1><article class="message">${letter.message}</article><section class="closing"><div><div>Regards,</div><div class="signature"><#if letter.signatureUrl?has_content><img src="${letter.signatureUrl?html}" alt="Signature"></#if></div><#if letter.signedBy?has_content><div class="signed">${letter.signedBy?html}</div></#if></div><div class="sender-card"><strong>${company.name?html}</strong><#if company.phone?has_content><br>${company.phone?html}</#if><#if company.email?has_content><br>${company.email?html}</#if></div></section></section><footer class="footer"><span><#if company.registrationNumber?has_content>Registration ${company.registrationNumber?html}</#if></span><span><#if company.website?has_content>${company.website?html}</#if></span></footer></main></body></html>
