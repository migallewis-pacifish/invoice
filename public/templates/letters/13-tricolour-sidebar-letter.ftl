<!doctype html><html><head><meta charset="utf-8"><title>${letter.title?html}</title><style>
@page{size:A4;margin:0}:root{--c1:${(theme.sidebarColor1!'#3a666d')};--c2:${(theme.sidebarColor2!'#2a7a87')};--c3:${(theme.sidebarColor3!'#71c2a7')}}*{box-sizing:border-box}body{margin:0;background:#e7eeec;color:#263b3d;font:12pt Arial,sans-serif}.page{width:210mm;min-height:297mm;margin:auto;background:#fff;display:grid;grid-template-columns:58mm 1fr}.side{padding:18mm 10mm;color:#fff;background:linear-gradient(165deg,var(--c1),var(--c2) 58%,var(--c3));position:relative}.logo{max-width:38mm;max-height:18mm;margin-bottom:8mm}.side h2{margin:0 0 5mm;font-size:19px}.side-copy{font-size:10px;line-height:1.65}.side-label{margin-top:13mm;font-size:8px;font-weight:bold;text-transform:uppercase;letter-spacing:.15em;opacity:.8}.main{padding:18mm 17mm 24mm}.top{display:flex;justify-content:space-between;align-items:start}.top h1{margin:0;color:var(--c2);font-size:32px;font-weight:300}.date{text-align:right;color:var(--c1)}.recipient{margin:16mm 0 12mm;padding:7mm;border-left:4px solid var(--c3);background:#f3f8f6;line-height:1.55}.label{font-size:9px;font-weight:bold;text-transform:uppercase;letter-spacing:.14em;color:var(--c2)}.recipient strong{display:block;font-size:17px;margin:4px 0}.subject{margin:0 0 8mm;color:var(--c1);font-size:20px}.message{white-space:pre-line;line-height:1.68}.closing{margin-top:14mm}.signature{height:18mm;display:flex;align-items:end}.signature img{max-width:45mm;max-height:16mm}.signed{font-weight:bold;color:var(--c1)}
</style></head><body><main class="page"><aside class="side"><#if company.logoUrl?has_content><img class="logo" src="${company.logoUrl?html}" alt=""><#else><h2>${company.name?html}</h2></#if><div class="side-copy"><#if company.address?has_content>${company.address?html}<br></#if><#if company.email?has_content>${company.email?html}<br></#if><#if company.phone?has_content>${company.phone?html}</#if></div><div class="side-label">Online</div><div class="side-copy"><#if company.website?has_content>${company.website?html}</#if></div></aside><section class="main"><header class="top"><h1>Letter</h1><div class="date"><span class="label">Date</span><br>${letter.date?html}</div></header><div class="recipient"><span class="label">To</span><strong>${client.name?html}</strong><#if client.address.line1?has_content>${client.address.line1?html}<br></#if><#if client.address.suburb?has_content>${client.address.suburb?html}<br></#if><#if client.address.city?has_content>${client.address.city?html}<#if client.address.postalCode?has_content> ${client.address.postalCode?html}</#if><br></#if><#if client.email?has_content>${client.email?html}</#if></div><h1 class="subject">${letter.title?html}</h1><article class="message">${letter.message}</article><section class="closing">Yours sincerely,<div class="signature"><#if letter.signatureUrl?has_content><img src="${letter.signatureUrl?html}" alt="Signature"></#if></div><#if letter.signedBy?has_content><div class="signed">${letter.signedBy?html}</div></#if></section></section></main></body></html>
