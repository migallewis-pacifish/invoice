<!doctype html>
<html><head><meta charset="utf-8"><title>${letter.title?html}</title><style>
@page{size:A4;margin:0}:root{--primary:${(theme.sidebarColor1!'#252a31')};--accent:${(theme.sidebarColor2!'#747b84')};--soft:${(theme.sidebarColor3!'#f0f1f2')}}*{box-sizing:border-box}body{margin:0;background:#e5e7eb;color:#222;font:11pt Arial,sans-serif}.page{width:210mm;min-height:297mm;margin:auto;background:#fff;display:grid;grid-template-columns:56mm 1fr}.rail{background:var(--primary);color:#fff;padding:20mm 10mm;position:relative}.mark{width:17mm;height:17mm;border:1px solid currentColor;display:grid;place-items:center;font-size:18pt;font-weight:bold;margin-bottom:13mm}.rail h2{font-size:16pt;margin:0 0 16mm;overflow-wrap:anywhere}.label{font-size:7.5pt;text-transform:uppercase;letter-spacing:.16em;opacity:.7;margin:8mm 0 2mm}.details{font-size:9pt;line-height:1.55;overflow-wrap:anywhere}.rail-foot{position:absolute;bottom:17mm;left:10mm;right:10mm;font-size:8pt;line-height:1.5;opacity:.8}.content{padding:20mm 20mm 22mm}.top{display:flex;justify-content:space-between;align-items:start;margin-bottom:19mm}.type{font-size:8pt;text-transform:uppercase;letter-spacing:.2em;color:var(--accent)}.date{font-weight:bold;color:var(--primary)}.recipient{padding-left:6mm;border-left:3px solid var(--accent);line-height:1.5;margin-bottom:14mm}.recipient strong{display:block;font-size:14pt;margin-bottom:2mm}.content h1{font-size:23pt;line-height:1.12;margin:0 0 10mm;color:var(--primary)}.message{white-space:pre-line;line-height:1.7}.closing{margin-top:16mm}.signature{height:18mm}.signature img{max-width:45mm;max-height:16mm}.name{font-weight:700}.role{font-size:9pt;color:var(--accent);margin-top:1mm}
</style></head><body><main class="page"><aside class="rail"><div class="mark">${company.name?substring(0,1)?upper_case?html}</div><h2>${company.name?html}</h2><div class="label">Address</div><div class="details"><#if company.address?has_content>${company.address?html}</#if></div><div class="label">Contact</div><div class="details"><#if company.phone?has_content>${company.phone?html}<br></#if><#if company.email?has_content>${company.email?html}</#if></div><div class="rail-foot"><#if company.website?has_content>${company.website?html}<br></#if><#if company.registrationNumber?has_content>Reg. ${company.registrationNumber?html}</#if></div></aside><section class="content"><header class="top"><span class="type">Correspondence</span><span class="date">${letter.date?html}</span></header><div class="recipient"><strong>${client.name?html}</strong><#if client.address?has_content>${client.address?html}<#else><#if client.street?has_content>${client.street?html}<br></#if><#if client.suburb?has_content>${client.suburb?html}<br></#if>${client.city?html}<#if client.postalCode?has_content> ${client.postalCode?html}</#if></#if></div><h1>${letter.title?html}</h1><article class="message">${letter.message?html}</article><footer class="closing"><div>Kind regards,</div><div class="signature"><#if letter.signatureUrl?has_content><img src="${letter.signatureUrl?html}" alt="Signature"></#if></div><#if letter.signedBy?has_content><div class="name">${letter.signedBy?html}</div></#if><div class="role">For ${company.name?html}</div></footer></section></main></body></html>

