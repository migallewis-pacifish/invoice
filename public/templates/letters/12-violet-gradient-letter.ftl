<!doctype html><html><head><meta charset="utf-8"><title>${letter.title?html}</title><style>
@page{size:A4;margin:0}*{box-sizing:border-box}body{margin:0;background:#eceaf4;color:#24223b;font:12pt Arial,sans-serif}.page{width:210mm;min-height:297mm;margin:auto;background:#fff;position:relative;overflow:hidden}.orb{position:absolute;width:90mm;height:90mm;border-radius:50%;right:-35mm;top:-42mm;background:#9f7aea}.head{height:51mm;padding:15mm 19mm;background:linear-gradient(125deg,#302561,#5b3cc4 68%,#8b5cf6);color:#fff;position:relative;display:flex;justify-content:space-between}.brand{font-size:19px;font-weight:bold}.head h1{margin:0;font-size:30px;font-weight:300;letter-spacing:.05em;z-index:1}.content{padding:12mm 19mm 42mm}.date{text-align:right;color:#5135aa}.recipient{margin:8mm 0 12mm;padding:7mm;background:#f7f5fc;border-radius:6px;line-height:1.55}.tag{font-size:9px;text-transform:uppercase;font-weight:bold;letter-spacing:.15em;color:#7658d6}.recipient strong{display:block;font-size:18px;margin:5px 0}.subject{font-size:20px;margin:0 0 8mm;color:#4b2fad}.message{white-space:pre-line;line-height:1.68}.closing{margin-top:14mm}.signature{height:17mm;display:flex;align-items:end}.signature img{max-width:44mm;max-height:15mm}.signed{font-weight:bold}.foot{position:absolute;left:0;right:0;bottom:0;min-height:30mm;background:#292344;color:#d8d2ef;padding:8mm 19mm;display:flex;justify-content:space-between;line-height:1.5}.foot b{color:#bba7ff}
</style></head><body><main class="page"><div class="orb"></div><header class="head"><div class="brand">${company.name?html}</div><h1>Letter</h1></header><div class="content"><div class="date">${letter.date?html}</div><section class="recipient"><span class="tag">Written for</span><strong>${client.name?html}</strong><#if client.address.line1?has_content>${client.address.line1?html}<br></#if><#if client.address.suburb?has_content>${client.address.suburb?html}<br></#if><#if client.address.city?has_content>${client.address.city?html}<#if client.address.postalCode?has_content> ${client.address.postalCode?html}</#if><br></#if><#if client.email?has_content>${client.email?html}</#if></section><h1 class="subject">${letter.title?html}</h1><article class="message">${letter.message}</article><section class="closing">Kind regards,<div class="signature"><#if letter.signatureUrl?has_content><img src="${letter.signatureUrl?html}" alt="Signature"></#if></div><#if letter.signedBy?has_content><div class="signed">${letter.signedBy?html}</div></#if></section></div><footer class="foot"><div><b>${company.name?html}</b><#if company.address?has_content><br>${company.address?html}</#if></div><div><#if company.email?has_content>${company.email?html}</#if><#if company.phone?has_content><br>${company.phone?html}</#if></div></footer></main></body></html>
