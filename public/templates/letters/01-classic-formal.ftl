<!doctype html>
<html><head><meta charset="utf-8"><title>${letter.title?html}</title><style>
@page{size:A4;margin:0}:root{--primary:${(theme.sidebarColor1!'#20242a')};--accent:${(theme.sidebarColor2!'#686f78')};--soft:${(theme.sidebarColor3!'#eceef0')}}*{box-sizing:border-box}body{margin:0;background:#e5e7eb;color:#202124;font:12pt Georgia,serif}.page{width:210mm;min-height:297mm;margin:auto;background:#fff;padding:22mm 24mm 20mm;position:relative}.head{display:flex;justify-content:space-between;gap:16mm;padding-bottom:8mm;border-bottom:2px solid var(--primary)}.brand{font-size:20pt;letter-spacing:.03em;color:var(--primary)}.sender{text-align:right;font:9.5pt Arial,sans-serif;line-height:1.55;color:#4b5563}.date{margin:13mm 0 8mm;font:10pt Arial,sans-serif;color:var(--accent)}.recipient{line-height:1.55;margin-bottom:11mm}.recipient strong{display:block;font-size:13pt;margin-bottom:1mm}.subject{margin:0 0 8mm;padding:4mm 0;border-top:1px solid var(--soft);border-bottom:1px solid var(--soft);font:700 10pt Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:var(--primary)}.message{white-space:pre-line;line-height:1.68}.closing{margin-top:15mm}.signature{height:18mm;display:flex;align-items:end}.signature img{display:block;max-width:45mm;max-height:16mm}.signed{font-weight:bold}.foot{position:absolute;left:24mm;right:24mm;bottom:13mm;padding-top:4mm;border-top:1px solid var(--soft);display:flex;justify-content:space-between;font:8.5pt Arial,sans-serif;color:#6b7280}
</style></head><body><main class="page"><header class="head"><div><#if company.logoUrl?has_content><img src="${company.logoUrl?html}" alt="" style="max-width:48mm;max-height:16mm"><#else><div class="brand">${company.name?html}</div></#if></div><div class="sender">${company.name?html}<#if company.address?has_content><br>${company.address?html}</#if><#if company.email?has_content><br>${company.email?html}</#if><#if company.phone?has_content><br>${company.phone?html}</#if></div></header><div class="date">${letter.date?html}</div><section class="recipient"><strong>${client.name?html}</strong><#if client.street?has_content>${client.street?html}<br></#if><#if client.suburb?has_content>${client.suburb?html}<br></#if><#if client.city?has_content>${client.city?html}<#if client.postalCode?has_content> ${client.postalCode?html}</#if><br></#if><#if client.email?has_content>${client.email?html}</#if></section><h1 class="subject">${letter.title?html}</h1><article class="message">${letter.message}</article><section class="closing"><div>Yours sincerely,</div><div class="signature"><#if letter.signatureUrl?has_content><img src="${letter.signatureUrl?html}" alt="Signature"></#if></div><#if letter.signedBy?has_content><div class="signed">${letter.signedBy?html}</div></#if></section><footer class="foot"><span><#if company.registrationNumber?has_content>Registration ${company.registrationNumber?html}</#if></span><span><#if company.website?has_content>${company.website?html}</#if></span></footer></main></body></html>

