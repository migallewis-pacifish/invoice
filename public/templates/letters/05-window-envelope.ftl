<!doctype html>
<html><head><meta charset="utf-8"><title>${letter.title?html}</title><style>
@page{size:A4;margin:0}:root{--primary:${(theme.sidebarColor1!'#24292f')};--accent:${(theme.sidebarColor2!'#6e7781')};--soft:${(theme.sidebarColor3!'#f0f2f4')}}*{box-sizing:border-box}body{margin:0;background:#e5e7eb;color:#24292f;font:11pt Arial,sans-serif}.page{width:210mm;min-height:297mm;margin:auto;background:#fff;padding:15mm 20mm 18mm;position:relative}.head{display:flex;justify-content:space-between;align-items:start}.brand{font-size:19pt;font-weight:800;color:var(--primary)}.sender{max-width:70mm;text-align:right;font-size:8.5pt;line-height:1.45;color:var(--accent)}.delivery-zone{height:58mm;margin:8mm -20mm 10mm;padding:13mm 20mm;background:var(--soft);display:grid;grid-template-columns:112mm 1fr;gap:10mm}.window{width:90mm;min-height:36mm;background:#fff;padding:7mm 9mm;border-left:4px solid var(--accent);box-shadow:0 1px 0 rgba(0,0,0,.08);line-height:1.5}.window strong{font-size:13pt;display:block;margin-bottom:2mm}.dispatch{text-align:right;font-size:9pt;color:var(--accent)}.dispatch b{display:block;color:var(--primary);font-size:10pt;margin-top:2mm}.title{font-size:21pt;margin:0 0 8mm;color:var(--primary)}.message{white-space:pre-line;line-height:1.68}.closing{margin-top:15mm}.signature{height:18mm}.signature img{max-width:45mm;max-height:16mm}.signed{font-weight:700}.footer{position:absolute;left:20mm;right:20mm;bottom:12mm;border-top:2px solid var(--primary);padding-top:4mm;display:grid;grid-template-columns:repeat(3,1fr);gap:6mm;font-size:8pt;color:var(--accent)}.footer div:nth-child(2){text-align:center}.footer div:last-child{text-align:right}
</style></head><body><main class="page"><header class="head"><div><#if company.logoUrl?has_content><img src="${company.logoUrl?html}" alt="" style="max-width:50mm;max-height:15mm"><#else><div class="brand">${company.name?html}</div></#if></div><div class="sender"><#if company.address?has_content>${company.address?html}<br></#if><#if company.email?has_content>${company.email?html}</#if></div></header><section class="delivery-zone"><div class="window"><strong>${client.name?html}</strong><#if client.street?has_content>${client.street?html}<br></#if><#if client.suburb?has_content>${client.suburb?html}<br></#if><#if client.city?has_content>${client.city?html}</#if><#if client.postalCode?has_content> ${client.postalCode?html}</#if><#if client.email?has_content><br>${client.email?html}</#if></div><div class="dispatch">Date issued<b>${letter.date?html}</b></div></section><h1 class="title">${letter.title?html}</h1><article class="message">${letter.message?html}</article><section class="closing"><div>Yours faithfully,</div><div class="signature"><#if letter.signatureUrl?has_content><img src="${letter.signatureUrl?html}" alt="Signature"></#if></div><#if letter.signedBy?has_content><div class="signed">${letter.signedBy?html}</div></#if></section><footer class="footer"><div>${company.name?html}</div><div><#if company.phone?has_content>${company.phone?html}</#if></div><div><#if company.website?has_content>${company.website?html}</#if></div></footer></main></body></html>

