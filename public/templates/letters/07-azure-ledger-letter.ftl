<!doctype html><html><head><meta charset="utf-8"><title>${letter.title?html}</title><style>
@page{size:A4;margin:0}*{box-sizing:border-box}body{margin:0;background:#edf2f7;color:#26364a;font:12pt Arial,sans-serif}.page{width:210mm;min-height:297mm;margin:auto;background:#fff;padding:18mm 19mm;position:relative}.top{height:18mm;margin:-18mm -19mm 16mm;padding:0 19mm;background:#3478d4;color:#fff;display:flex;align-items:center;justify-content:space-between}.brand{font-size:18px;font-weight:700}.kind{font-size:24px;font-weight:300;letter-spacing:.08em}.meta{display:flex;justify-content:space-between;gap:16mm;margin-bottom:14mm}.label{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#3478d4}.recipient{line-height:1.55}.recipient strong{display:block;font-size:15px;margin:4px 0}.date{color:#245ca8;text-align:right}.subject{margin:0 0 8mm;padding:4mm 0;border-top:1px solid #c9dcf7;border-bottom:1px solid #c9dcf7;font-size:12px;text-transform:uppercase;letter-spacing:.09em;color:#245ca8}.message{white-space:pre-line;line-height:1.68}.closing{margin-top:14mm}.signature{height:18mm;display:flex;align-items:end}.signature img{max-width:45mm;max-height:16mm}.signed{font-weight:bold}.footer{position:absolute;left:19mm;right:19mm;bottom:15mm;border-top:1px solid #c9dcf7;padding-top:7px;display:flex;justify-content:space-between;font-size:9px;color:#5e7187}
</style></head><body><main class="page"><header class="top"><div class="brand">${company.name?html}</div><div class="kind">LETTER</div></header><section class="meta"><div class="recipient"><div class="label">To</div><strong>${client.name?html}</strong><#if client.address.line1?has_content>${client.address.line1?html}<br></#if><#if client.address.suburb?has_content>${client.address.suburb?html}<br></#if><#if client.address.city?has_content>${client.address.city?html}<#if client.address.postalCode?has_content> ${client.address.postalCode?html}</#if><br></#if><#if client.email?has_content>${client.email?html}</#if></div><div class="date"><div class="label">Date</div>${letter.date?html}</div></section><h1 class="subject">${letter.title?html}</h1><article class="message">${letter.message}</article><section class="closing">Yours sincerely,<div class="signature"><#if letter.signatureUrl?has_content><img src="${letter.signatureUrl?html}" alt="Signature"></#if></div><#if letter.signedBy?has_content><div class="signed">${letter.signedBy?html}</div></#if></section><footer class="footer"><span>${company.name?html}<#if company.email?has_content> · ${company.email?html}</#if></span><span><#if company.phone?has_content>${company.phone?html}</#if><#if company.website?has_content> · ${company.website?html}</#if></span></footer></main></body></html>
