<!doctype html><html><head><meta charset="utf-8"><title>${letter.title?html}</title><style>
@page{size:A4;margin:0}*{box-sizing:border-box}body{margin:0;background:#eee;color:#253044;font:12pt Arial,sans-serif}.page{width:210mm;min-height:297mm;margin:auto;background:#fff;display:grid;grid-template-columns:55mm 1fr}.side{background:#18324b;color:#e9f0f5;padding:18mm 10mm;position:relative}.monogram{width:15mm;height:15mm;background:#ff6b5d;border-radius:4px;display:grid;place-items:center;font-size:22px;font-weight:bold;margin-bottom:9mm}.side h2{font-size:18px;margin:0 0 4mm}.side-block{margin-top:13mm;line-height:1.65;color:#c7d6df}.side-block b{display:block;color:#ff8b80;text-transform:uppercase;font-size:9px;letter-spacing:.14em;margin-bottom:3px}.main{padding:18mm 16mm 25mm}.mast{display:flex;justify-content:space-between;align-items:start}.mast h1{font-size:34px;margin:0;color:#ff6255;letter-spacing:-.04em}.date{text-align:right;line-height:1.7}.recipient{margin:17mm 0 13mm;padding:7mm 8mm;background:#fff4f1;border-radius:5px;line-height:1.55}.eyebrow{font-size:9px;font-weight:bold;text-transform:uppercase;letter-spacing:.13em;color:#ff6255}.recipient strong{display:block;font-size:17px;margin:4px 0}.subject{font-size:18px;margin:0 0 8mm;padding-bottom:4mm;border-bottom:2px solid #18324b}.message{white-space:pre-line;line-height:1.68}.closing{margin-top:13mm}.signature{height:17mm;display:flex;align-items:end}.signature img{max-width:42mm;max-height:15mm}.signed{font-weight:bold}
</style></head><body><main class="page"><aside class="side"><div class="monogram">${company.name?substring(0,1)?upper_case?html}</div><h2>${company.name?html}</h2><#if company.address?has_content><div>${company.address?html}</div></#if><div class="side-block"><b>Contact</b><#if company.email?has_content>${company.email?html}</#if><#if company.phone?has_content><br>${company.phone?html}</#if></div><div class="side-block"><b>Online</b><#if company.website?has_content>${company.website?html}</#if></div></aside><section class="main"><header class="mast"><h1>Letter</h1><div class="date">${letter.date?html}</div></header><div class="recipient"><span class="eyebrow">Addressed to</span><strong>${client.name?html}</strong><#if client.address.line1?has_content>${client.address.line1?html}<br></#if><#if client.address.suburb?has_content>${client.address.suburb?html}<br></#if><#if client.address.city?has_content>${client.address.city?html}<#if client.address.postalCode?has_content> ${client.address.postalCode?html}</#if><br></#if><#if client.email?has_content>${client.email?html}</#if></div><h1 class="subject">${letter.title?html}</h1><article class="message">${letter.message}</article><section class="closing">Kind regards,<div class="signature"><#if letter.signatureUrl?has_content><img src="${letter.signatureUrl?html}" alt="Signature"></#if></div><#if letter.signedBy?has_content><div class="signed">${letter.signedBy?html}</div></#if></section></section></main></body></html>
