<!doctype html><html><head><meta charset="utf-8"><title>${letter.title?html}</title><style>
@page{size:A4;margin:0}*{box-sizing:border-box}body{margin:0;background:#ddd;color:#111;font:12pt Arial,sans-serif}.page{width:210mm;min-height:297mm;margin:auto;background:#fff;padding:15mm;position:relative}.head{display:grid;grid-template-columns:1fr 1fr;border:2px solid #111}.logo,.heading{padding:9mm}.logo{font-size:18px;font-weight:bold}.heading{background:#111;color:#fff;text-align:right}.heading h1{margin:0;font-size:30px;text-transform:uppercase;letter-spacing:.12em}.grid{display:grid;grid-template-columns:1fr 1fr;border:2px solid #111;border-top:0}.cell{padding:8mm;border-right:2px solid #111;min-height:38mm;line-height:1.55}.cell:last-child{border:0}.kicker{font-size:9px;text-transform:uppercase;letter-spacing:.18em;font-weight:bold}.name{font-size:17px;font-weight:bold;margin:5px 0}.subject{margin:12mm 0 8mm;padding:5mm;border:2px solid #111;font-size:17px;text-transform:uppercase}.message{white-space:pre-line;line-height:1.65}.closing{margin-top:14mm;padding-top:5mm;border-top:5px solid #111;width:50%}.signature{height:17mm;display:flex;align-items:end}.signature img{max-width:44mm;max-height:15mm}.signed{font-weight:bold}.footer{position:absolute;left:15mm;right:15mm;bottom:15mm;border:2px solid #111;padding:6mm;display:flex;justify-content:space-between;font-size:10px}
</style></head><body><main class="page"><header class="head"><div class="logo">${company.name?html}</div><div class="heading"><h1>Letter</h1></div></header><section class="grid"><div class="cell"><span class="kicker">Recipient</span><div class="name">${client.name?html}</div><#if client.address.line1?has_content>${client.address.line1?html}<br></#if><#if client.address.suburb?has_content>${client.address.suburb?html}<br></#if><#if client.address.city?has_content>${client.address.city?html}<#if client.address.postalCode?has_content> ${client.address.postalCode?html}</#if></#if></div><div class="cell"><span class="kicker">Date</span><div class="name">${letter.date?html}</div><#if client.email?has_content>${client.email?html}</#if></div></section><h1 class="subject">${letter.title?html}</h1><article class="message">${letter.message}</article><section class="closing">Yours sincerely,<div class="signature"><#if letter.signatureUrl?has_content><img src="${letter.signatureUrl?html}" alt="Signature"></#if></div><#if letter.signedBy?has_content><div class="signed">${letter.signedBy?html}</div></#if></section><footer class="footer"><span><#if company.email?has_content>${company.email?html}</#if></span><span><#if company.phone?has_content>${company.phone?html}</#if></span></footer></main></body></html>
