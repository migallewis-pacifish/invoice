<!doctype html><html><head><meta charset="utf-8"><title>${letter.title?html}</title><style>
@page{size:A4;margin:0}*{box-sizing:border-box}body{margin:0;background:#e8eef0;color:#073b4c;font:12pt Arial,sans-serif}.page{width:210mm;min-height:297mm;margin:auto;background:#fff;position:relative}.hero{height:42mm;padding:13mm 20mm;background:linear-gradient(110deg,#062f43,#0e6174 65%,#16a9b8);color:#fff;display:flex;justify-content:space-between;align-items:center}.brand{font-size:22px;font-weight:700}.hero h1{margin:0;font-size:27px;font-weight:400;letter-spacing:.1em}.content{padding:12mm 20mm 42mm}.date{text-align:right;color:#0e6174}.recipient{margin:10mm 0 13mm;line-height:1.55}.eyebrow{color:#1993a3;font-size:9px;text-transform:uppercase;font-weight:bold;letter-spacing:.14em}.recipient strong{display:block;font-size:16px;margin:5px 0}.subject{font-size:17px;margin:0 0 8mm;padding-bottom:4mm;border-bottom:2px solid #18a4b3}.message{white-space:pre-line;line-height:1.68;color:#274f5b}.closing{margin-top:14mm}.signature{height:17mm;display:flex;align-items:end}.signature img{max-width:45mm;max-height:15mm}.signed{font-weight:bold}.bottom{position:absolute;bottom:0;left:0;right:0;min-height:29mm;background:#063c50;color:#d9f6f7;padding:8mm 20mm;display:flex;justify-content:space-between;line-height:1.5}.bottom b{color:#54d6db}
</style></head><body><main class="page"><header class="hero"><div class="brand">${company.name?html}</div><h1>CORRESPONDENCE</h1></header><div class="content"><div class="date">${letter.date?html}</div><section class="recipient"><div class="eyebrow">Prepared for</div><strong>${client.name?html}</strong><#if client.address.line1?has_content>${client.address.line1?html}<br></#if><#if client.address.suburb?has_content>${client.address.suburb?html}<br></#if><#if client.address.city?has_content>${client.address.city?html}<#if client.address.postalCode?has_content> ${client.address.postalCode?html}</#if><br></#if><#if client.email?has_content>${client.email?html}</#if></section><h1 class="subject">${letter.title?html}</h1><article class="message">${letter.message}</article><section class="closing">Kind regards,<div class="signature"><#if letter.signatureUrl?has_content><img src="${letter.signatureUrl?html}" alt="Signature"></#if></div><#if letter.signedBy?has_content><div class="signed">${letter.signedBy?html}</div></#if></section></div><footer class="bottom"><div><b>${company.name?html}</b><#if company.address?has_content><br>${company.address?html}</#if></div><div><#if company.email?has_content>${company.email?html}</#if><#if company.phone?has_content><br>${company.phone?html}</#if></div></footer></main></body></html>
