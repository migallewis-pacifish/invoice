<!doctype html><html><head><meta charset="utf-8"><title>Invoice ${invoice.number?html}</title><style>
.foot{height:46mm!important;padding:6mm 19mm!important}.content{padding-bottom:54mm!important}
@page{size:A4;margin:0}*{box-sizing:border-box}body{margin:0;background:#eceaf4;color:#24223b;font:12px Arial,sans-serif}.page{width:210mm;min-height:297mm;margin:auto;background:#fff;position:relative;overflow:hidden}.orb{position:absolute;width:90mm;height:90mm;border-radius:50%;right:-35mm;top:-42mm;background:#9f7aea}.head{height:51mm;padding:15mm 19mm;background:linear-gradient(125deg,#302561,#5b3cc4 68%,#8b5cf6);color:#fff;position:relative;display:flex;justify-content:space-between}.brand{font-size:19px;font-weight:bold}.head h1{margin:0;font-size:36px;font-weight:300;letter-spacing:.05em;z-index:1}.content{padding:12mm 19mm 38mm}.topline{display:flex;justify-content:space-between}.meta{display:grid;grid-template-columns:auto auto;gap:4px 14px;text-align:left}.meta b{text-align:right;color:#5135aa}.bill{margin-top:8mm}.tag{font-size:9px;text-transform:uppercase;font-weight:bold;letter-spacing:.15em;color:#7658d6}.bill strong{display:block;font-size:18px;margin:5px 0}.addr{line-height:1.55;color:#6b6880}.from{text-align:right}.items{width:100%;border-collapse:separate;border-spacing:0;margin-top:15mm;box-shadow:0 8px 25px #34236d14;border-radius:7px;overflow:hidden}th{background:#44308c;color:#fff;padding:10px;font-size:9px;text-transform:uppercase;letter-spacing:.1em}td{padding:10px;background:#fff;border-bottom:1px solid #ece8fa}th:first-child,td:first-child{text-align:left}th,td{text-align:right}.summary{width:45%;margin:6mm 0 0 auto;border-collapse:collapse}.summary td{padding:5px}.summary tr:last-child td{background:#f0ebff;color:#4b2fad;font-size:18px;font-weight:bold;border-top:2px solid #7c5ce0}.note{margin-top:13mm;max-width:55%;padding:7mm;background:#f7f5fc;border-radius:6px;line-height:1.6}.foot{position:absolute;left:0;right:0;bottom:0;height:30mm;background:#292344;color:#d8d2ef;padding:8mm 19mm;display:flex;justify-content:space-between}.foot b{color:#bba7ff;display:block;font-size:9px;text-transform:uppercase;letter-spacing:.13em;margin-bottom:4px}.thanks{text-align:right;color:#fff;font-size:15px;font-weight:bold}
</style></head><body><main class="page"><div class="orb"></div><header class="head"><div class="brand">${company.name?html}</div><h1>Invoice</h1></header><div class="content"><div class="topline"><div><div class="meta"><span>Invoice number</span><b>${invoice.number?html}</b><span>Issue date</span><b>${invoice.date?html}</b><span>Payment due</span><b>${invoice.dueDate?html}</b></div><div class="bill"><span class="tag">Billed to</span><strong>${client.name?html}</strong><div class="addr">${client.address.line1?html}<br>${client.address.suburb?html}, ${client.address.city?html} ${client.address.postalCode?html}<br>${client.email?html}</div></div></div><div class="from"><span class="tag">From</span><strong>${company.name?html}</strong><div class="addr">${company.address?html}<br>${company.email?html}<#if company.phone?has_content><br>${company.phone?html}</#if></div></div></div><table class="items"><thead><tr><th>Service description</th><th>Quantity</th><th>Rate</th><th>Amount</th></tr></thead><tbody><#list invoice.items as item><tr><td>${item.description?html}</td><td>${item.hours?html}</td><td>${item.rate?html}</td><td>${item.amount?html}</td></tr></#list></tbody></table><table class="summary"><tr><td>Subtotal</td><td>${invoice.subtotal?html}</td></tr><tr><td>VAT ${invoice.vatPercentage?html}%</td><td>${invoice.vat?html}</td></tr><tr><td>Total</td><td>${invoice.total?html}</td></tr></table><#if invoice.notes?has_content><div class="note"><span class="tag">Notes</span><br><br>${invoice.notes?html}</div></#if></div><footer class="foot"><div><b>Account details</b><#if (payment.bankName)?has_content>Bank: ${payment.bankName?html}<br></#if><#if (payment.accountHolder)?has_content>Account holder: ${payment.accountHolder?html}<br></#if><#if (payment.accountType)?has_content>Account type: ${payment.accountType?html}<br></#if><#if (payment.accountNumber)?has_content>Account number: ${payment.accountNumber?html}<br></#if><#if (payment.branchCode)?has_content>Branch code: ${payment.branchCode?html}<br></#if><#if (payment.reference)?has_content>Reference: ${payment.reference?html}</#if></div><div class="thanks">Thanks for choosing us.</div></footer></main></body></html>
