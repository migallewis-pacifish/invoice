<!doctype html><html><head><meta charset="utf-8"><title>Invoice ${invoice.number?html}</title><style>
@page{size:A4;margin:0}*{box-sizing:border-box}body{margin:0;background:#ddd;color:#111;font:12px Arial,sans-serif}.page{width:210mm;min-height:297mm;margin:auto;background:#fff;padding:15mm;position:relative}.head{display:grid;grid-template-columns:1fr 1fr;border:2px solid #111}.logo,.heading{padding:9mm}.logo{font-size:18px;font-weight:bold}.heading{background:#111;color:#fff;text-align:right}.heading h1{margin:0;font-size:36px;text-transform:uppercase;letter-spacing:.12em}.grid{display:grid;grid-template-columns:1fr 1fr;border:2px solid #111;border-top:0}.cell{padding:8mm;border-right:2px solid #111;min-height:40mm}.cell:last-child{border:0}.kicker{font-size:9px;text-transform:uppercase;letter-spacing:.18em;font-weight:bold}.name{font-size:17px;font-weight:bold;margin:5px 0}.copy{line-height:1.6}.meta{display:grid;grid-template-columns:auto 1fr;gap:5px 14px;margin-top:7mm}.meta b{text-align:right}table{width:100%;border-collapse:collapse;margin-top:12mm;border:2px solid #111}th{background:#111;color:white;text-transform:uppercase;font-size:9px;letter-spacing:.1em}th,td{padding:9px;border-right:1px solid #111;border-bottom:1px solid #111;text-align:right}th:first-child,td:first-child{text-align:left}th:last-child,td:last-child{border-right:0}.totals{width:45%;margin:0 0 0 auto;border-top:0}.totals td{border-bottom:1px solid #111}.totals tr:last-child td{background:#111;color:#fff;font-size:17px;font-weight:bold}.notes{width:50%;margin-top:12mm;padding-top:5mm;border-top:5px solid #111;line-height:1.6}.footer{position:absolute;left:15mm;right:15mm;bottom:15mm;border:2px solid #111;padding:7mm;display:grid;grid-template-columns:1fr 1fr}.footer div:last-child{text-align:right;font-weight:bold;font-size:14px}
</style></head><body><main class="page"><header class="head"><div class="logo">${company.name?html}</div><div class="heading"><h1>Invoice</h1></div></header><section class="grid"><div class="cell"><span class="kicker">From</span><div class="name">${company.name?html}</div><div class="copy">${company.address?html}<br>${company.email?html}<#if company.phone?has_content><br>${company.phone?html}</#if></div></div><div class="cell"><span class="kicker">Bill to</span><div class="name">${client.name?html}</div><div class="copy">${client.address.line1?html}, ${client.address.suburb?html}<br>${client.address.city?html} ${client.address.postalCode?html}<br>${client.email?html}</div><div class="meta"><span>Invoice</span><b>${invoice.number?html}</b><span>Date</span><b>${invoice.date?html}</b><span>Due</span><b>${invoice.dueDate?html}</b></div></div></section><table><thead><tr><th>Description</th><th>Hours / units</th><th>Rate</th><th>Amount</th></tr></thead><tbody><#list invoice.items as item><tr><td>${item.description?html}</td><td>${item.hours?html}</td><td>${item.rate?html}</td><td>${item.amount?html}</td></tr></#list></tbody></table><table class="totals"><tr><td>Subtotal</td><td>${invoice.subtotal?html}</td></tr><tr><td>VAT (${invoice.vatPercentage?html}%)</td><td>${invoice.vat?html}</td></tr><tr><td>Total due</td><td>${invoice.total?html}</td></tr></table><#if invoice.notes?has_content><div class="notes"><span class="kicker">Notes</span><br><br>${invoice.notes?html}</div></#if><footer class="footer"><div><span class="kicker">Account details</span><br><br><#if (payment.bankName)?has_content>Bank: ${payment.bankName?html}<br></#if><#if (payment.accountHolder)?has_content>Account holder: ${payment.accountHolder?html}<br></#if><#if (payment.accountType)?has_content>Account type: ${payment.accountType?html}<br></#if><#if (payment.accountNumber)?has_content>Account number: ${payment.accountNumber?html}<br></#if><#if (payment.branchCode)?has_content>Branch code: ${payment.branchCode?html}<br></#if><#if (payment.reference)?has_content>Reference: ${payment.reference?html}</#if></div><div>THANK YOU FOR<br>YOUR BUSINESS.</div></footer></main></body></html>
