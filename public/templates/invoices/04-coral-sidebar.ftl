<!doctype html><html><head><meta charset="utf-8"><title>Invoice ${invoice.number?html}</title><style>
.side .thanks{position:static;margin-top:5mm}
@page{size:A4;margin:0}*{box-sizing:border-box}body{margin:0;background:#eee;color:#253044;font:12px Arial,sans-serif}.page{width:210mm;min-height:297mm;margin:auto;background:#fff;display:grid;grid-template-columns:55mm 1fr}.side{background:#18324b;color:#e9f0f5;padding:18mm 10mm;position:relative}.monogram{width:15mm;height:15mm;background:#ff6b5d;border-radius:4px;display:grid;place-items:center;font-size:22px;font-weight:bold;margin-bottom:9mm}.side h2{font-size:18px;margin:0 0 4mm}.side-block{margin-top:16mm;line-height:1.65;color:#c7d6df}.side-block b{display:block;color:#ff8b80;text-transform:uppercase;font-size:9px;letter-spacing:.14em;margin-bottom:3px}.side .pay{position:absolute;left:10mm;right:10mm;bottom:17mm}.main{padding:18mm 16mm 25mm}.mast{display:flex;justify-content:space-between;align-items:start}.mast h1{font-size:38px;margin:0;color:#ff6255;letter-spacing:-.04em}.number{text-align:right;line-height:1.7}.number b{font-size:15px}.client{margin:20mm 0 14mm;padding:7mm 8mm;background:#fff4f1;border-radius:5px}.eyebrow{font-size:9px;font-weight:bold;text-transform:uppercase;letter-spacing:.13em;color:#ff6255}.client strong{display:block;font-size:17px;margin:4px 0}.address{line-height:1.55;color:#5d6674}table{width:100%;border-collapse:collapse}th{font-size:9px;text-transform:uppercase;letter-spacing:.08em;color:#6e7681;padding:8px;border-bottom:2px solid #18324b}td{padding:9px 8px;border-bottom:1px solid #d9dfe4}th:first-child,td:first-child{text-align:left}th,td{text-align:right}.sum{width:55%;margin:5mm 0 0 auto}.sum td{border:0;padding:5px}.sum tr:last-child{background:#ff6b5d;color:#fff;font-size:16px;font-weight:bold}.notes{margin-top:13mm;border-top:1px solid #d9dfe4;padding-top:6mm;line-height:1.55}.thanks{position:absolute;bottom:17mm;color:#ff9c93;font-size:14px;font-weight:bold}
</style></head><body><main class="page"><aside class="side"><div class="monogram">${company.name?substring(0,1)?upper_case?html}</div><h2>${company.name?html}</h2><div>${company.address?html}</div><div class="side-block"><b>Contact</b>${company.email?html}<#if company.phone?has_content><br>${company.phone?html}</#if></div><div class="side-block pay"><b>Account details</b><#if (payment.bankName)?has_content>Bank: ${payment.bankName?html}<br></#if><#if (payment.accountHolder)?has_content>Account holder: ${payment.accountHolder?html}<br></#if><#if (payment.accountType)?has_content>Account type: ${payment.accountType?html}<br></#if><#if (payment.accountNumber)?has_content>Account number: ${payment.accountNumber?html}<br></#if><#if (payment.branchCode)?has_content>Branch code: ${payment.branchCode?html}<br></#if><#if (payment.reference)?has_content>Reference: ${payment.reference?html}</#if><div class="thanks">Thank you!</div></div></aside><section class="main"><header class="mast"><h1>Invoice</h1><div class="number"><b>#${invoice.number?html}</b><br>Issued ${invoice.date?html}<br>Due ${invoice.dueDate?html}</div></header><div class="client"><span class="eyebrow">Invoice to</span><strong>${client.name?html}</strong><div class="address">${client.address.line1?html}, ${client.address.suburb?html}<br>${client.address.city?html} ${client.address.postalCode?html}<br>${client.email?html}</div></div><table><thead><tr><th>Description</th><th>Qty</th><th>Price</th><th>Amount</th></tr></thead><tbody><#list invoice.items as item><tr><td>${item.description?html}</td><td>${item.hours?html}</td><td>${item.rate?html}</td><td>${item.amount?html}</td></tr></#list></tbody></table><table class="sum"><tr><td>Subtotal</td><td>${invoice.subtotal?html}</td></tr><tr><td>VAT ${invoice.vatPercentage?html}%</td><td>${invoice.vat?html}</td></tr><tr><td>Total</td><td>${invoice.total?html}</td></tr></table><#if invoice.notes?has_content><div class="notes"><span class="eyebrow">Notes</span><br>${invoice.notes?html}</div></#if></section></main></body></html>
