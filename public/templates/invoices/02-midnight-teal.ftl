<!doctype html><html><head><meta charset="utf-8"><title>Invoice ${invoice.number?html}</title><style>
@page{size:A4;margin:0}*{box-sizing:border-box}body{margin:0;background:#e8eef0;color:#073b4c;font:13px Arial,sans-serif}.page{width:210mm;min-height:297mm;margin:auto;background:#fff;position:relative}.hero{height:42mm;padding:13mm 20mm;background:linear-gradient(110deg,#062f43,#0e6174 65%,#16a9b8);color:#fff;display:flex;justify-content:space-between;align-items:center}.brand{font-size:22px;font-weight:700;letter-spacing:.04em}.hero h1{margin:0;font-size:34px;letter-spacing:.1em}.content{padding:12mm 20mm 35mm}.invoice-meta{text-align:right;color:#0e6174;line-height:1.7}.parties{display:grid;grid-template-columns:1fr 1fr;gap:20mm;margin:10mm 0 18mm}.parties>div:last-child{text-align:right}.eyebrow{color:#1993a3;font-size:10px;text-transform:uppercase;font-weight:bold;letter-spacing:.14em}.person{font-size:16px;font-weight:bold;margin:5px 0}.address{line-height:1.55;color:#355b66}table{width:100%;border-collapse:collapse}th{background:#063c50;color:white;padding:9px;font-size:10px;text-transform:uppercase}th:first-child,td:first-child{text-align:left}th,td{text-align:right}td{padding:8px;border-bottom:1px solid #9bd3d8}.summary{margin:4px 0 0 auto;width:48%}.summary td{border:0}.summary tr:last-child td{border-top:2px solid #18a4b3;font-size:18px;font-weight:bold}.message{margin-top:14mm;width:55%;color:#54727a;line-height:1.6}.bottom{position:absolute;bottom:0;left:0;right:0;min-height:29mm;background:#063c50;color:#d9f6f7;padding:8mm 20mm;display:flex;justify-content:space-between;align-items:center}.pay strong{display:block;color:#54d6db;text-transform:uppercase;font-size:10px;letter-spacing:.12em;margin-bottom:4px}.thanks{font-size:15px;font-weight:bold;text-align:right}
</style></head><body><main class="page"><header class="hero"><div class="brand">${company.name?html}</div><h1>INVOICE</h1></header><div class="content"><div class="invoice-meta"><b>No. ${invoice.number?html}</b><br>Issued ${invoice.date?html} &nbsp;·&nbsp; Due ${invoice.dueDate?html}</div><section class="parties"><div><div class="eyebrow">From</div><div class="person">${company.name?html}</div><div class="address">${company.address?html}<br>${company.email?html}<#if company.phone?has_content><br>${company.phone?html}</#if></div></div><div><div class="eyebrow">Prepared for</div><div class="person">${client.name?html}</div><div class="address">${client.street?html}<br>${client.suburb?html}, ${client.city?html} ${client.postalCode?html}<br>${client.email?html}</div></div></section><table><thead><tr><th>Description</th><th>Items</th><th>Rate / price</th><th>Amount</th></tr></thead><tbody><#list invoice.items as item><tr><td>${item.description?html}</td><td>${item.hours?html}</td><td>${item.rate?html}</td><td>${item.amount?html}</td></tr></#list></tbody></table><table class="summary"><tr><td>Excluding VAT</td><td>${invoice.subtotal?html}</td></tr><tr><td>VAT ${invoice.vatPercentage?html}%</td><td>${invoice.vat?html}</td></tr><tr><td>Total</td><td>${invoice.total?html}</td></tr></table><#if invoice.notes?has_content><div class="message"><span class="eyebrow">Notes</span><br>${invoice.notes?html}</div></#if></div><footer class="bottom"><div class="pay"><strong>Payment reference</strong>${payment.reference?html}</div><div class="thanks">Thank you for your business!</div></footer></main></body></html>
