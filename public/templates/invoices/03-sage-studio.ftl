<!doctype html><html><head><meta charset="utf-8"><title>Invoice ${invoice.number?html}</title><style>
@page{size:A4;margin:0}*{box-sizing:border-box}body{margin:0;background:#eeeae1;color:#273b35;font:13px Georgia,serif}.page{width:210mm;min-height:297mm;margin:auto;background:#fcfaf4;padding:18mm 19mm;position:relative}.head{display:flex;justify-content:space-between;align-items:start;border-bottom:1px solid #9caf9f;padding-bottom:11mm}.mark{width:16mm;height:16mm;border:1px solid #647e70;border-radius:50%;display:grid;place-items:center;font:700 20px Arial;color:#647e70}.brand{margin-left:5mm}.brand-name{font-size:20px}.brand-wrap{display:flex;align-items:center}.invoice-title{text-align:right}.invoice-title h1{font-size:34px;font-weight:normal;margin:0;color:#526d60}.invoice-title div{font-family:Arial;font-size:11px;line-height:1.7}.intro{display:grid;grid-template-columns:1fr 1fr;margin:15mm 0 17mm;gap:20mm}.intro>div:last-child{padding-left:10mm;border-left:1px solid #c8d2c8}.label{font:700 9px Arial;text-transform:uppercase;letter-spacing:.16em;color:#8b664a}.name{font-size:17px;margin:5px 0}.copy{line-height:1.6;color:#53625d}table{width:100%;border-collapse:collapse}thead{border-top:1px solid #637f70;border-bottom:1px solid #637f70}th{padding:9px 7px;font:700 9px Arial;text-transform:uppercase;letter-spacing:.1em}td{padding:10px 7px;border-bottom:1px solid #dcd8cd}th:first-child,td:first-child{text-align:left}th,td{text-align:right}.totals{width:45%;margin:7mm 0 0 auto}.totals td{padding:5px;border:0}.totals .total td{border-top:1px solid #637f70;padding-top:9px;font-size:18px}.note{margin-top:15mm;max-width:60%;font-style:italic;line-height:1.65}.foot{position:absolute;bottom:16mm;left:19mm;right:19mm;border-top:1px solid #9caf9f;padding-top:7mm;display:flex;justify-content:space-between;font-family:Arial;font-size:11px}.foot b{color:#8b664a}.thank{font-family:Georgia;font-size:16px;font-style:italic}
</style></head><body><main class="page"><header class="head"><div class="brand-wrap"><div class="mark">${company.name?substring(0,1)?upper_case?html}</div><div class="brand"><div class="brand-name">${company.name?html}</div><div class="copy">${company.email?html}</div></div></div><div class="invoice-title"><h1>Invoice</h1><div>${invoice.number?html}<br>${invoice.date?html} · due ${invoice.dueDate?html}</div></div></header><section class="intro"><div><div class="label">Our studio</div><div class="name">${company.name?html}</div><div class="copy">${company.address?html}<#if company.phone?has_content><br>${company.phone?html}</#if></div></div><div><div class="label">Created for</div><div class="name">${client.name?html}</div><div class="copy">${client.address.line1?html}<br>${client.address.suburb?html}<br>${client.address.city?html} ${client.address.postalCode?html}<br>${client.email?html}</div></div></section><table><thead><tr><th>Project / description</th><th>Quantity</th><th>Rate</th><th>Line total</th></tr></thead><tbody><#list invoice.items as item><tr><td>${item.description?html}</td><td>${item.hours?html}</td><td>${item.rate?html}</td><td>${item.amount?html}</td></tr></#list></tbody></table><table class="totals"><tr><td>Subtotal</td><td>${invoice.subtotal?html}</td></tr><tr><td>VAT (${invoice.vatPercentage?html}%)</td><td>${invoice.vat?html}</td></tr><tr class="total"><td>Total due</td><td>${invoice.total?html}</td></tr></table><#if invoice.notes?has_content><div class="note"><span class="label">A note from us</span><br>${invoice.notes?html}</div></#if><footer class="foot"><div><b>ACCOUNT DETAILS</b><br><#if (payment.bankName)?has_content>Bank: ${payment.bankName?html}<br></#if><#if (payment.accountHolder)?has_content>Account holder: ${payment.accountHolder?html}<br></#if><#if (payment.accountType)?has_content>Account type: ${payment.accountType?html}<br></#if><#if (payment.accountNumber)?has_content>Account number: ${payment.accountNumber?html}<br></#if><#if (payment.branchCode)?has_content>Branch code: ${payment.branchCode?html}<br></#if><#if (payment.reference)?has_content>Reference: ${payment.reference?html}</#if></div><div class="thank">With thanks.</div></footer></main></body></html>
