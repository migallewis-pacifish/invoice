<!doctype html><html><head><meta charset="utf-8"><title>Letterhead</title></head><body style="margin:0;background:#f4f6f8;color:#172033;font:16px/1.55 Arial,sans-serif"><table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr><td align="center" style="padding:28px 12px"><table role="presentation" width="600" cellspacing="0" cellpadding="0" style="width:100%;max-width:600px;background:#fff;border-collapse:collapse"><tr><td style="padding:22px 34px;background:${(theme.primary)!'#243b53'};color:#fff;font-size:24px;font-weight:bold">${company.name?html}</td></tr><tr><td style="padding:38px 34px"><h1 style="margin:0 0 20px;font-size:28px">Hello ${client.name?html},</h1><p>${message.body?html}</p><p style="margin-top:28px">Kind regards,<br><b>${company.name?html}</b></p></td></tr><tr><td style="height:8px;background:${(theme.accent)!'#e8eef3'}"></td></tr></table></td></tr></table></body></html>