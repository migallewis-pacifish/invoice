<!doctype html><html><head><meta charset="utf-8"><title>Receipt</title></head><body style="margin:0;background:#f4f6f8;color:#172033;font:16px/1.55 Arial,sans-serif"><table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr><td align="center" style="padding:28px 12px"><table role="presentation" width="600" cellspacing="0" cellpadding="0" style="width:100%;max-width:600px;background:#fff;border-collapse:collapse"><tr><td style="padding:28px 32px;background:${(theme.accent)!'#dcfce7'}"><small style="color:${(theme.primary)!'#14532d'}"><b>PAYMENT UPDATE</b></small><h1 style="color:${(theme.primary)!'#14532d'}">Thank you, ${client.name?html}</h1></td></tr><tr><td style="padding:30px 32px"><p>${message.body?html}</p><table role="presentation" width="100%" style="border-top:2px solid ${(theme.secondary)!'#16a34a'}"><tr><td style="padding-top:18px"><small>INVOICE</small><br><b>${invoice.number?html}</b></td><td style="padding-top:18px"><small>AMOUNT</small><br><b>${invoice.total?html}</b></td><td style="padding-top:18px"><small>DUE</small><br><b>${invoice.dueDate?html}</b></td></tr></table></td></tr><tr><td style="padding:18px 32px;background:${(theme.primary)!'#14532d'};color:#fff"><b>${company.name?html}</b></td></tr></table></td></tr></table></body></html>