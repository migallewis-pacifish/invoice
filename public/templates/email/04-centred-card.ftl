<!doctype html><html><head><meta charset="utf-8"><title>Centred card</title></head><body style="margin:0;background:#f4f6f8;color:#172033;font:16px/1.55 Arial,sans-serif"><table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr><td align="center" style="padding:28px 12px"><table role="presentation" width="600" cellspacing="0" cellpadding="0" style="width:100%;max-width:600px;background:#fff;border-collapse:collapse"><tr><td style="padding:42px 30px;background:${(theme.accent)!'#e0e7ff'}"><table role="presentation" width="88%" align="center" style="background:#fff"><tr><td style="padding:38px;text-align:center"><b style="color:${(theme.primary)!'#4338ca'}">${company.name?html}</b><h1>A short message with impact</h1><p>Hello ${client.name?html},</p><p>${message.body?html}</p><p style="color:${(theme.secondary)!'#6366f1'}"><b>Kind regards,<br>${company.name?html}</b></p></td></tr></table></td></tr></table></td></tr></table></body></html>