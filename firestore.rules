rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userCompanyId() {
      return signedIn() && userProfile().data.companyId is string
        ? userProfile().data.companyId
        : null;
    }

    function companyDoc(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId));
    }

    function isCompanyMember(companyId) {
      return signedIn()
        && userCompanyId() == companyId
        && request.auth.uid in companyDoc(companyId).data.users;
    }

    function isCreatingOwnCompany(companyId) {
      return signedIn()
        && request.resource.data.users is list
        && request.auth.uid in request.resource.data.users
        && !request.resource.data.keys().hasAny(['emailIntegrations', 'emailIntegrationStatus'])
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || userCompanyId() == companyId);
    }

    function emailPreferencesAreValid() {
      return request.resource.data.keys().hasOnly([
          'companyId', 'defaultProvider', 'onboardingCompleted', 'selectedSender',
          'nexusFallback', 'updatedAt'
        ])
        && request.resource.data.companyId is string
        && request.resource.data.defaultProvider in [
          'gmail', 'microsoft_exchange', 'company_sendgrid', 'nexus_fallback'
        ]
        && request.resource.data.onboardingCompleted is bool
        && (!('selectedSender' in request.resource.data)
          || request.resource.data.selectedSender.keys().hasOnly(['email', 'displayName']))
        && (!('nexusFallback' in request.resource.data)
          || (request.resource.data.nexusFallback.keys().hasOnly(['enabled', 'replyToEmail'])
            && request.resource.data.nexusFallback.enabled is bool));
    }

    match /users/{userId} {
      allow get, update, delete: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow list: if false;
    }

    match /companies/{companyId} {
      allow get, list: if isCompanyMember(companyId);
      allow create: if isCreatingOwnCompany(companyId);
      // Connection metadata is server-owned. This also prevents clients from
      // reviving the legacy embedded emailIntegrations representation.
      allow update: if isCompanyMember(companyId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'emailIntegrations', 'emailIntegrationStatus'
        ]);
      allow delete: if isCompanyMember(companyId);

      match /emailIntegration/{documentId} {
        allow read: if isCompanyMember(companyId)
          && documentId in ['preferences', 'status'];
        allow create, update: if isCompanyMember(companyId)
          && documentId == 'preferences'
          && request.resource.data.companyId == companyId
          && emailPreferencesAreValid();
        allow delete: if false;
      }

      // OAuth/API credentials and their operational metadata are never client-visible.
      match /privateEmailTokens/{document=**} {
        allow read, write: if false;
      }

      match /clients/{clientId} {
        allow read, write: if isCompanyMember(companyId);

        match /invoices/{invoiceId} {
          allow read, write: if isCompanyMember(companyId);
        }

        match /letters/{letterId} {
          allow read, write: if isCompanyMember(companyId);
        }

        match /expenses/{expenseId} {
          allow read, write: if isCompanyMember(companyId);
        }
      }

      match /expenses/{expenseId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /invoiceSummaries/{invoiceId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /activities/{activityId} {
        allow read, create: if isCompanyMember(companyId);
        allow update, delete: if false;
      }

      match /templates/{templateId} {
        allow read: if isCompanyMember(companyId);
        allow create, update: if isCompanyMember(companyId)
          && request.resource.data.companyId == companyId
          && request.resource.data.type in ['invoice', 'letter']
          && request.resource.data.storagePath is string;
        allow delete: if isCompanyMember(companyId);
      }

      match /emailDesignTemplates/{templateId} {
        allow read: if isCompanyMember(companyId);
        allow create, update: if isCompanyMember(companyId)
          && request.resource.data.companyId == companyId
          && request.resource.data.name is string
          && request.resource.data.subject is string
          && request.resource.data.sections is list
          && request.resource.data.freemarkerStoragePath is string
          && request.resource.data.variables is list;
        allow delete: if isCompanyMember(companyId);
      }

      match /emailTemplates/{templateId} {
        allow read: if isCompanyMember(companyId);
        allow create, update: if isCompanyMember(companyId)
          && request.resource.data.companyId == companyId
          && request.resource.data.subject is string
          && request.resource.data.bodyStoragePath is string
          && request.resource.data.variables is list
          && !('body' in request.resource.data);
        allow delete: if isCompanyMember(companyId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
